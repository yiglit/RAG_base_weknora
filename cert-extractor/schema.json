{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cert_no": {"$ref": "#/$defs/any_field"},
    "institution": {"$ref": "#/$defs/any_field"},
    "manufacturer": {"$ref": "#/$defs/any_field"},
    "product_name": {"$ref": "#/$defs/any_field"},
    "model_spec": {"$ref": "#/$defs/any_field"},
    "ex_marking": {"$ref": "#/$defs/any_field"},
    "standard": {"$ref": "#/$defs/any_field"},
    "drawing_no": {"$ref": "#/$defs/any_field"},
    "issue_date": {"$ref": "#/$defs/any_field"},
    "valid_until": {"$ref": "#/$defs/any_field"},
    "voltage": {"$ref": "#/$defs/any_field"},
    "current": {"$ref": "#/$defs/any_field"},
    "enclosure": {"$ref": "#/$defs/any_field"}
  },
  "required": ["cert_no", "institution", "model_spec", "ex_marking"],
  "$defs": {
    "any_field": {
      "anyOf": [
        {"$ref": "#/$defs/field"},
        {"$ref": "#/$defs/multi_field"},
        {"type": "null"}
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {"type": ["string", "null"]},
        "raw_value": {"type": ["string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "quote": {"type": ["string", "null"]},
        "page": {"type": ["integer", "null"]},
        "bbox": {
          "type": ["array", "null"],
          "items": {"type": "number"}
        }
      },
      "required": ["value", "confidence", "quote"]
    },
    "multi_field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "values": {"type": "array", "items": {"type": "string"}},
        "raw_value": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "quote": {"type": ["string", "null"]},
        "page": {"type": ["integer", "null"]},
        "bbox": {"type": ["array", "null"]}
      },
      "required": ["values", "confidence", "quote"]
    }
  }
}
